rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user must be signed in (Firebase Authentication)
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: user can only act as themselves
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Public content: readable by anyone (needed for the site/feed to
    // work for visitors and to be indexable), writable only by signed-in
    // users. This still relies on app-level checks for "only edit your own
    // post", which should also be enforced in the client code.
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /communities/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /stories/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /ads/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /pages/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /jobs/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /ideas/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /lives/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /live_messages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- User profiles: publicly readable (needed for profiles/search),
    // but a user may only create/edit/delete their OWN document. Never
    // store plaintext passwords in these documents (use Firebase
    // Authentication for that instead).
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    // --- Private messaging: only members of the chat may read/write.
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
    }

    match /messages/{messageId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /friend_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isSignedIn() &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // --- Sensitive / admin-only data: never exposed to normal clients.
    // Payout configuration contains secret payment-gateway keys (Stripe,
    // Mercado Pago, PIX, bank details) and must only ever be read/written
    // from a trusted backend (e.g. server.ts using the Admin SDK), never
    // directly from the browser.
    match /payout_config/{doc} {
      allow read, write: if false;
    }

    match /payout_requests/{doc} {
      allow read, write: if false;
    }

    match /logs/{doc} {
      allow read, write: if false;
    }

    // Default: deny anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

